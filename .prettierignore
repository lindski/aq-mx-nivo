# Generated by the build on every run — formatting it is churn, and linting it makes the
# release gate fail on the second consecutive build.
typings/
dist/

# The tooling's own prettier glob is hardcoded to {src,typings,tests}/**, and the generator's
# ignore file only knew about tests/testProject. A real Mendix app at tests/<AppName> therefore
# pulls a few hundred vendored Atlas and Marketplace theme files into the style check, which
# fails and exits BEFORE the build runs. There is no test app here any more — it is a separate
# Team Server repo — but the rule stays, widened, so putting one back cannot break the gate.
tests/

# The widget XML. Prettier reflows <description> text across lines, and that whitespace renders
# verbatim in Studio Pro property pane. The plugin default (xmlWhitespaceSensitivity: "strict")
# does NOT prevent it. Those descriptions are also carried verbatim into the page tooling's
# auto-schema, so reflowing them damages documentation an agent reads.
src/**/*.xml
